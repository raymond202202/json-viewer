{
  "name": "json-viewer",
  "version": "1.0.0",
  "description": "JSON 阅读器 - 粘贴 JSON 即可展开/收拢查看",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.comate.json-viewer",
    "productName": "JSON阅读器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Utility"
    },
    "portable": {
      "artifactName": "JSON阅读器.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
